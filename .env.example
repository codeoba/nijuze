# Nijuze Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://nijuze.com
API_URL=https://api.nijuze.com

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://nijuze:nijuze_password@localhost:5432/nijuze
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nijuze
DB_USER=nijuze
DB_PASSWORD=nijuze_password

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# AWS S3 (File Storage)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=nijuze-uploads
AWS_REGION=us-east-1
AWS_S3_PUBLIC_URL=https://nijuze-uploads.s3.amazonaws.com

# ============================================
# EMAIL (SendGrid)
# ============================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@nijuze.com
FROM_NAME=Nijuze

# ============================================
# OPENAI (AI Features)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4

# ============================================
# SOCIAL AUTH (Optional)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.nijuze.com/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://api.nijuze.com/api/auth/github/callback

# Twitter OAuth
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_CALLBACK_URL=https://api.nijuze.com/api/auth/twitter/callback

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# SECURITY
# ============================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://nijuze.com
CORS_CREDENTIALS=true

# ============================================
# WEBSOCKET
# ============================================
WEBSOCKET_URL=wss://ws.nijuze.com
WEBSOCKET_PING_INTERVAL=25000
WEBSOCKET_PING_TIMEOUT=60000

# ============================================
# CACHE
# ============================================
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=nijuze-backups
